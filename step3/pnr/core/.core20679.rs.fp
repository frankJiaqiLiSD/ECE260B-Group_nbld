#####################################################################
#  <Property>                                                       #
#     <obj_type name="inst_name" >                                  #
#       <prop name="name" type=type_name value=val />               #
#       <Attr name="name" type=type_name value=val />               #
#     </obj_type>                                                   #
#  </Property>                                                      #
#  where:                                                           #
#       type is data type: Box, String, Int, PTR, Loc, double, Bits #
#       obj_type are: inst, Design, instTerm, Bump, cell, net       #
#####################################################################
<Properties>
  <inst name="mac_array_instance">
	<prop name="InstHalo" type=Box llx=3.0000 lly=3.0000 urx=3.0000 ury=3.0000 />
	<Attr name="instHaloType" type=Int value=0 />
  </inst>
  <inst name="ofifo_inst">
	<prop name="InstHalo" type=Box llx=3.0000 lly=3.0000 urx=3.0000 ury=3.0000 />
	<Attr name="instHaloType" type=Int value=0 />
  </inst>
  <inst name="qmem_instance">
	<prop name="InstHalo" type=Box llx=3.0000 lly=3.0000 urx=3.0000 ury=3.0000 />
	<Attr name="instHaloType" type=Int value=0 />
  </inst>
  <inst name="kmem_instance">
	<prop name="InstHalo" type=Box llx=3.0000 lly=3.0000 urx=3.0000 ury=3.0000 />
	<Attr name="instHaloType" type=Int value=0 />
  </inst>
  <inst name="psum_mem_instance">
	<prop name="InstHalo" type=Box llx=3.0000 lly=3.0000 urx=3.0000 ury=3.0000 />
	<Attr name="instHaloType" type=Int value=0 />
  </inst>
  <Design name="core">
	<prop name="CUT_ROWS" type=Int value=0 />
  </Design>
</Properties>

###########################################################$############################################################################################
#  GlobalNetConnection: <net_name> {-pin|-inst|-net} <base_name_pattern> -type {pgpin|net|tiehi|tielo} {-all|-module <name>|-region <box>} [-override] #
########################################################################################################################################################
GlobalNetConnection: VDD -pin VDD -inst * -type pgpin -all
GlobalNetConnection: VSS -pin VSS -inst * -type pgpin -all
GlobalNetConnection: VDD -pin VDD -singleInst qmem_instance -type pgpin -override
GlobalNetConnection: VSS -pin VSS -singleInst qmem_instance -type pgpin -override
GlobalNetConnection: VDD -pin VDD -singleInst kmem_instance -type pgpin -override
GlobalNetConnection: VSS -pin VSS -singleInst kmem_instance -type pgpin -override
GlobalNetConnection: VDD -pin VDD -singleInst mac_array_instance -type pgpin -override
GlobalNetConnection: VSS -pin VSS -singleInst mac_array_instance -type pgpin -override
GlobalNetConnection: VDD -pin VDD -singleInst ofifo_inst -type pgpin -override
GlobalNetConnection: VSS -pin VSS -singleInst ofifo_inst -type pgpin -override
GlobalNetConnection: VDD -pin VDD -singleInst psum_mem_instance -type pgpin -override
GlobalNetConnection: VSS -pin VSS -singleInst psum_mem_instance -type pgpin -override

################################################################################
#  NetProperties: <net_name> [-special] [-def_prop {int|dbl|str} <value>]...   #
################################################################################

